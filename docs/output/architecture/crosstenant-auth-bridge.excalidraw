      "updated": 0,
      "link": null,
      "locked": false,
      "text": "Implementation view, not deployment status. Frontend SPFx Web Part runs in Tenant A (M365 GCC Moderate); Azure Function and Foundry run in Tenant B (Azure Government).",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
